CONFIG_CC_MATE_BATTERY=y
# CONFIG_BT_ENABLED is not set

# LVGL: big font for balance / percentage numbers
CONFIG_LV_FONT_MONTSERRAT_20=y

# HTTPS certificate bundle (bigmodel.cn / api.deepseek.com)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Power saving: 80MHz + PM + tickless idle
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_80=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Main task stack: portal HTML + WiFi scan buffers
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
